---
import BaseLayout from '../layouts/BaseLayout.astro';
import CallToAction from '../components/CallToAction.astro';
import VideoSection from '../components/VideoSection.astro';
import Packages from '../components/Packages.astro';
import Events from '../components/Events.astro';
import Testimonials from '../components/Testimonials.astro';
import Gallery from '../components/Gallery.astro';
import { business, programs } from '../site';
---
<BaseLayout title="Personal Soccer & Performance Training in NYC" description="Train with Charles Okeke at Moïse Soccer & Performance Training in NYC. Explore private sessions, small-group training, highlights, and booking.">
<section class="dark-surface relative overflow-hidden bg-ink text-white">
<div class="shell grid lg:min-h-[680px] lg:grid-cols-[1.05fr_1fr]">
<div class="relative z-10 py-14 sm:py-20 lg:pr-8"><p class="eyebrow mb-7 text-white/75">New York City · Player development</p><h1 class="display text-[clamp(3.4rem,7.5vw,6.8rem)]">Own your<br />game.<br /><span class="outline-word">Build your<br class="sm:hidden" /> edge.</span></h1><p class="mt-7 max-w-md text-lg leading-relaxed text-white/70">Personal soccer and performance training with Coach Charles Okeke. Focused work. Purposeful movement. Your next step forward.</p><div class="mt-8 flex flex-wrap gap-4"><a class="button" href="/booking/">Book a session <span aria-hidden="true">↗</span></a><a class="button button-outline" href="#videos">Watch the training <span aria-hidden="true">▶</span></a></div></div>
<div class="relative min-h-[460px] lg:my-9"><img src="/images/training-photo.jpg" alt="Moïse players practicing together on a soccer field" width="480" height="640" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover object-center" /><div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/5 to-transparent"></div><div class="absolute left-6 right-6 top-6 flex items-start justify-between"><span class="chip bg-ink/75">On the field / NYC</span><img src="/images/moise-logo.png" alt="Moïse Soccer & Performance Training crest" width="86" height="86" class="size-20 bg-white object-contain" /></div><div class="absolute bottom-8 left-7 right-7"><p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-accent">The work starts here</p><p class="display text-4xl">Show up.<br />Put in the reps.</p></div></div>
</div></section>
<div class="bg-accent"><div class="shell flex flex-wrap items-center justify-between gap-x-8 gap-y-3 py-5 text-sm font-bold uppercase tracking-[0.12em]"><span>01 / Soccer skills</span><span>02 / Performance</span><span>03 / Player development</span></div></div>
<section id="training" class="shell section-pad"><div class="section-head"><div><p class="eyebrow mb-5">Find your focus</p><h2 class="section-title">Different goals.<br />Same commitment.</h2></div><a class="text-link" href="/services/">Explore training & plans ↗</a></div><div class="grid gap-8 md:grid-cols-3">{programs.map((program,i)=><article><div class="relative aspect-[4/3] overflow-hidden"><img src={program.image} alt={program.title + ' session on the field'} width="480" height="640" loading="lazy" class="media-image" /><span class="absolute bottom-0 left-0 bg-paper px-4 py-2 text-sm font-bold">0{i+1}</span></div><h3 class="display mt-6 text-3xl">{program.title}</h3><p class="mt-3 text-muted leading-relaxed">{program.description}</p></article>)}</div></section>
<section id="bio" class="bg-[#e7ebdf]"><div class="shell grid gap-10 py-16 md:grid-cols-[0.85fr_1.15fr] md:items-center lg:gap-20"><figure class="relative mx-auto w-full max-w-md"><img src="/images/coach-charles.jpg" alt="Coach Charles Okeke" width="360" height="640" loading="lazy" class="aspect-[4/5] w-full object-cover object-top" /><figcaption class="absolute bottom-0 left-0 right-0 bg-ink p-5 text-white"><span class="block text-xs font-bold uppercase tracking-widest text-accent">Meet your coach</span><span class="mt-1 block text-xl font-bold">Charles Okeke</span></figcaption></figure><div><p class="eyebrow mb-5">Behind the training</p><h2 class="section-title">A coach in<br />your corner.</h2><p class="body-copy mt-6">{business.bio}</p><p class="body-copy mt-5">Bring your goals to the field. Work on the details, build confidence on the ball, and make your next session count.</p><a class="text-link mt-7" href="/about/">Get to know Coach Charles ↗</a></div></div></section>
<VideoSection /><Packages /><Events /><Testimonials /><Gallery />
<section id="booking" class="shell section-pad section-rule"><div class="section-head"><div><p class="eyebrow mb-5">Booking & payment</p><h2 class="section-title">Your next session.<br />A few steps away.</h2></div><a class="text-link" href="/booking/">Open booking options ↗</a></div><div class="grid gap-8 md:grid-cols-3">{[{n:'01',title:'Find a time',text:'Check current availability through the coach’s Calendly booking page.',href:'/booking/',cta:'Check availability'},{n:'02',title:'Confirm the details',text:'Ask about training location, the right session for you, and current rates.',href:'/contact/',cta:'Contact the coach'},{n:'03',title:'Arrange payment',text:'Confirm your booking and payment instructions with the coach.',href:'/payment/',cta:'Payment information'}].map(step=><article class="border-t border-ink/30 pt-6"><p class="text-sm font-bold text-forest">{step.n} /</p><h3 class="display mt-5 text-3xl">{step.title}</h3><p class="mt-4 text-muted leading-relaxed">{step.text}</p><a class="text-link mt-4" href={step.href}>{step.cta} ↗</a></article>)}</div></section>
<div class="shell flex flex-wrap items-center gap-4 border-t border-ink/15 py-6"><p class="mr-2 text-sm text-muted">Accepted payments</p>{business.paymentMethods.map(method=><span class="chip">{method}</span>)}<a class="text-link ml-auto" href="/payment/">Payment details ↗</a></div>
<section id="contact" class="shell section-rule flex flex-col justify-between gap-6 py-12 md:flex-row md:items-center"><div><p class="eyebrow mb-3">Contact us</p><h2 class="display text-4xl">Not sure where to start?</h2><p class="mt-4 text-muted">Tell us about your goals. We’ll take it from there.</p></div><a href="/contact/" class="button button-dark">Send an enquiry ↗</a></section>
<CallToAction />
</BaseLayout>
