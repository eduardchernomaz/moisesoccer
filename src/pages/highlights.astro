---
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoSection from '../components/VideoSection.astro';
import Gallery from '../components/Gallery.astro';
import CallToAction from '../components/CallToAction.astro';
---
<BaseLayout title="Training Videos & Photos" description="Watch Moïse training session highlights and explore photos from Charles Okeke’s soccer and performance training in NYC.">
<section class="shell py-14 sm:py-20"><p class="eyebrow mb-6">Training in motion</p><h1 class="display text-5xl sm:text-8xl">Less talk.<br /><span class="text-forest">More touches.</span></h1><p class="body-copy mt-7 max-w-2xl">A look inside the sessions: the movement, the ball work, and the moments in between.</p></section>
<VideoSection /><Gallery /><CallToAction />
</BaseLayout>
