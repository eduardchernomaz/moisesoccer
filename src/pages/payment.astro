---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, validExternalUrl } from '../site';
const paymentUrl = validExternalUrl(business.paymentUrl);
---
<BaseLayout title="Payment Information" description="Moïse accepts Zelle, Venmo, and Cash App. Confirm the amount and recipient details with Coach Charles before paying for your training.">
<section class="shell section-pad grid gap-12 lg:grid-cols-2"><div><p class="eyebrow mb-6">Payment</p><h1 class="display text-5xl sm:text-7xl">Session sorted.<br /><span class="text-forest">Next, payment.</span></h1><p class="body-copy mt-7 max-w-xl">Pay for your training with Zelle, Venmo, or Cash App. Confirm your session or monthly plan and its rate with the coach before paying.</p><a class="text-link mt-6" href="/services/#packages">View plans & rate enquiries ↗</a></div><div class="border border-ink/20 bg-white p-8 sm:p-10"><p class="eyebrow mb-6">Accepted payment methods</p><ul class="space-y-3">{business.paymentMethods.map((method,i)=><li class="flex items-center justify-between border border-ink/15 px-5 py-4"><span class="text-xl font-bold">{method}</span><span class="text-sm font-semibold text-forest">0{i+1}</span></li>)}</ul><h2 class="display mt-8 text-3xl">Confirm. Then send.</h2><p class="mt-4 leading-relaxed text-muted">Contact Coach Charles to confirm the amount and the correct Zelle recipient, Venmo username, or Cash App $Cashtag. Send payment only after those details are confirmed.</p>{paymentUrl?<a class="button button-dark mt-7" href={paymentUrl} target="_blank" rel="noopener noreferrer">Continue to payment ↗</a>:<a class="button button-dark mt-7" href="/contact/?plan=payment">Request payment details ↗</a>}<p class="mt-6 text-sm text-muted">Payments are completed in your chosen payment app. This website does not collect card or bank details.</p></div></section>
</BaseLayout>
