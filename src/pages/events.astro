---
import BaseLayout from '../layouts/BaseLayout.astro';
import Events from '../components/Events.astro';
import CallToAction from '../components/CallToAction.astro';
---
<BaseLayout title="Events & Small-Group Training" description="Sign up for Moïse Winter Soccer Group Training in Old Bethpage. Explore Sunday sessions, birth-year groups, dates, and four- or six-week rates.">
<section class="shell py-14 sm:py-20"><p class="eyebrow mb-6">Get on the field together</p><h1 class="display text-5xl sm:text-8xl">Your group.<br /><span class="text-forest">Your next challenge.</span></h1><p class="body-copy mt-7 max-w-2xl">Bring the energy. Explore winter group training, find your session dates, and sign up below.</p></section>
<Events /><CallToAction />
</BaseLayout>
