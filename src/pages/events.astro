---
import BaseLayout from '../layouts/BaseLayout.astro';
import Events from '../components/Events.astro';
import CallToAction from '../components/CallToAction.astro';
---
<BaseLayout title="Events & Small-Group Training" description="Enquire about upcoming Moïse small-group soccer training events in New York City. Confirm dates, locations, player levels, and rates with the coach.">
<section class="shell py-14 sm:py-20"><p class="eyebrow mb-6">Get on the field together</p><h1 class="display text-5xl sm:text-8xl">Your group.<br /><span class="text-forest">Your next challenge.</span></h1><p class="body-copy mt-7 max-w-2xl">Bring the energy. Ask about upcoming sessions and the group that’s right for your game.</p></section>
<Events /><CallToAction />
</BaseLayout>
