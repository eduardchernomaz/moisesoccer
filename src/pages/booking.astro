---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business } from '../site';
---
<BaseLayout title="Book Soccer Training" description="Check Coach Charles Okeke’s availability and book through the Moïse Calendly scheduling page.">
<section class="shell section-pad grid gap-12 lg:grid-cols-[1.1fr_0.9fr]"><div><p class="eyebrow mb-6">Booking</p><h1 class="display text-5xl sm:text-7xl">Make your<br /><span class="text-forest">next move.</span></h1><p class="body-copy mt-7 max-w-xl">Choose a time through the coach’s Calendly page. Review the session details and complete your booking there.</p><a class="button button-dark mt-8" href={business.bookingUrl} target="_blank" rel="noopener noreferrer">Check times on Calendly <span aria-hidden="true">↗</span></a><p class="mt-4 text-sm text-muted">Opens Calendly in a new tab. Your session is confirmed only after you complete its booking process.</p><div class="mt-10 border-t border-ink/20 pt-7"><h2 class="display text-3xl">Looking for a monthly plan<br />or a group session?</h2><p class="body-copy mt-4">Contact the coach first to discuss the right package and current availability.</p><a class="text-link mt-4" href="/contact/">Ask about training options ↗</a></div></div><aside class="dark-surface bg-ink p-8 text-white sm:p-10"><p class="eyebrow mb-6">Before your session</p><h2 class="display text-4xl">A little planning.<br />A better start.</h2><ol class="mt-8 space-y-7">{['Check the available dates and times in Calendly.','Confirm the training location, session details, and rate.','Review payment and cancellation details with the coach.'].map((step,i)=><li class="flex gap-4 border-t border-white/20 pt-5"><span class="font-bold text-accent">0{i+1}</span><p class="text-white/80 leading-relaxed">{step}</p></li>)}</ol><a href="/payment/" class="text-link mt-8 text-accent">Payment information ↗</a></aside></section>
</BaseLayout>
