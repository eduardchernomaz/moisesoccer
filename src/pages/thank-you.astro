---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Enquiry Received" description="Thank you for contacting Moïse Soccer & Performance Training." noindex>
<section class="shell section-pad"><p class="eyebrow mb-6">Enquiry received</p><h1 class="display max-w-3xl text-5xl sm:text-7xl">You’ve made<br /><span class="text-forest">the first move.</span></h1><p class="body-copy mt-7 max-w-xl">Thanks for getting in touch. Your enquiry has been sent, and the coach can reply using the email address you provided.</p><p class="mt-5 max-w-xl text-muted">This is an enquiry confirmation. No training session has been booked and no payment has been taken.</p><div class="mt-8 flex flex-wrap gap-4"><a class="button button-dark" href="/booking/">View booking options ↗</a><a class="text-link" href="/">Back to home ↗</a></div></section>
</BaseLayout>
