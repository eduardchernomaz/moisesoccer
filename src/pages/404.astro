---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found" description="This page could not be found." noindex>
<section class="shell section-pad"><p class="eyebrow mb-6">404 / Page not found</p><h1 class="display text-5xl sm:text-7xl">Out of bounds.</h1><p class="body-copy mt-7">That page may have moved, or the address isn’t quite right.</p><a class="button button-dark mt-9" href="/">Back to the home page ↗</a></section>
</BaseLayout>
