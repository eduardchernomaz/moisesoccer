---
import { events } from '../site';
---
<section id="events" class="shell section-pad section-rule">
  <div class="section-head">
    <div><p class="eyebrow mb-5">Events / small-group training</p><h2 class="section-title">More energy.<br />More ways to grow.</h2></div>
    <a href="/contact/?plan=group" class="text-link">Ask about group training ↗</a>
  </div>
  {events.length ? <div class="space-y-10">{events.map(event =>
    <article id={event.id} class="grid overflow-hidden border border-ink/15 bg-white lg:grid-cols-[0.85fr_1.15fr]">
      <div class="order-2 bg-[#e6ebdf] p-5 sm:p-8 lg:order-1">
        <a href={event.image} target="_blank" rel="noopener noreferrer" class="block" aria-label={'View full-size ' + event.title + ' flyer (opens in a new tab)'}>
          <img src={event.image} alt={event.title + ' flyer. Session details and registration are provided alongside.'} width="1152" height="1536" loading="lazy" class="mx-auto h-auto w-full max-w-lg" />
        </a>
        <a href={event.image} target="_blank" rel="noopener noreferrer" class="text-link mt-3">View full-size flyer ↗</a>
        {event.flyerNote && <p class="mt-2 text-sm leading-relaxed text-muted">{event.flyerNote}</p>}
      </div>
      <div class="order-1 min-w-0 p-6 sm:p-9 lg:order-2">
        <p class="eyebrow mb-5">Winter training / Indoor</p>
        <h3 class="display text-4xl sm:text-5xl">{event.title}</h3>
        <p class="mt-5 text-xl font-bold text-forest">{event.date}</p>
        <p class="mt-2 text-muted">{event.location}</p>
        <a class="button button-dark mt-6 w-full sm:w-auto" href={event.registrationUrl} target="_blank" rel="noopener noreferrer">Sign up for winter training ↗</a>
        <p class="mt-2 text-sm text-muted">Registration opens in Google Forms.</p>
        <div class="mt-7 grid gap-5 border-y border-ink/15 py-6 sm:grid-cols-2">
          {event.groups.map(group => <div><h4 class="font-bold">Birth years {group.label}</h4><ul class="mt-2 space-y-1 text-muted">{group.dates.map(dates => <li>{dates}</li>)}</ul></div>)}
        </div>
        <div class="mt-6 flex flex-wrap gap-x-10 gap-y-4">{event.rates.map(rate => <p><strong class="text-2xl">{rate.price}</strong><span class="mt-1 block text-sm text-muted">per player · {rate.label}</span></p>)}</div>
        <p class="mt-5 font-semibold leading-relaxed">{event.details}</p>
        <h4 class="mt-6 font-bold">Training focus</h4>
        <ul class="mt-3 grid list-disc gap-2 pl-5 text-muted sm:grid-cols-2">{event.focus.map(item => <li>{item}</li>)}</ul>
        <p class="mt-6 border-t border-ink/15 pt-5 text-sm font-semibold">{event.footwear}</p>
        <p class="mt-2 text-sm leading-relaxed text-muted">Payment is required during registration. Follow the Zelle or Venmo instructions in the registration form.</p>
      </div>
    </article>
  )}</div> : <p class="body-copy">Ask about upcoming small-group sessions and availability. <a class="underline" href="/contact/?plan=group">Contact the coach</a>.</p>}
</section>
