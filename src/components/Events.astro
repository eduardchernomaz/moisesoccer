---
import { events } from '../site';
---
<section id="events" class="shell section-pad section-rule"><div class="section-head"><div><p class="eyebrow mb-5">Events / small-group training</p><h2 class="section-title">More energy.<br />More ways to grow.</h2></div><a href="/contact/?plan=group" class="text-link">Ask about group training ↗</a></div>{events.length ? <div class="grid gap-5 md:grid-cols-2">{events.map(event=><article class="border border-ink/20 bg-white p-7"><p class="eyebrow">{event.date}</p><h3 class="display mt-5 text-3xl">{event.title}</h3><p class="mt-4 text-muted">{event.location}</p><p class="body-copy mt-3">{event.details}</p><p class="mt-4 font-bold">{event.rate}</p><a class="button button-dark mt-6" href="/contact/?plan=group">Request a place ↗</a></article>)}</div> : <div class="grid overflow-hidden bg-[#e6ebdf] md:grid-cols-2"><img src="/images/training-photo.jpg" alt="Players working together during a soccer session" width="480" height="640" loading="lazy" class="h-full max-h-[420px] w-full object-cover object-[center_60%]" /><div class="flex flex-col justify-center p-8 sm:p-12"><span class="chip w-fit">Dates to be announced</span><h3 class="display mt-6 text-4xl">Find your next<br />group session.</h3><p class="body-copy mt-5">Ask about upcoming small-group training in New York City. The coach will confirm the date, location, player level, and rate before you commit.</p><a class="text-link mt-6" href="/contact/?plan=group">Request event details ↗</a></div></div>}</section>
