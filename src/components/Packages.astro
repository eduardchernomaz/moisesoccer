---
import { plans } from '../site';
---
<section id="packages" class="shell section-pad"><div class="section-head"><div><p class="eyebrow mb-5">Monthly packages / plans & rates</p><h2 class="section-title">Make training<br />part of your routine.</h2></div><p class="body-copy max-w-sm">Choose a starting point. Confirm the current rate, session length, and availability directly with the coach.</p></div><div class="grid gap-5 lg:grid-cols-3">{plans.map((plan,i)=><article class:list={['flex flex-col border p-7 sm:p-8',i===1?'border-forest bg-forest text-white dark-surface':'border-ink/20 bg-white']}><p class:list={['text-xs font-bold tracking-[0.14em]',i===1?'text-accent':'text-muted']}>{plan.category}</p><h3 class="display mt-6 text-4xl">{plan.title}</h3><p class:list={['mt-4 min-h-14 leading-relaxed',i===1?'text-white/75':'text-muted']}>{plan.description}</p><p class="mt-7 text-2xl font-bold">{plan.rate || 'Ask for current rate'}</p><p class:list={['mt-2 text-sm',i===1?'text-white/65':'text-muted']}>{plan.rate?'Confirm availability before purchase.':'Rates and package details to be confirmed.'}</p><ul class="my-7 space-y-4 border-t border-current/20 pt-6">{plan.details.map(detail=><li class="flex gap-3 text-sm leading-relaxed"><span aria-hidden="true">↗</span>{detail}</li>)}</ul><a class:list={['button mt-auto',i!==1&&'button-dark']} href={'/contact/?plan='+plan.id}>Enquire about this plan ↗</a></article>)}</div></section>
