---
import { testimonials } from '../site';
---
<section id="testimonials" class="shell section-pad section-rule"><div class="section-head"><div><p class="eyebrow mb-5">Testimonials</p><h2 class="section-title">The players.<br />The parents.<br /><span class="text-forest">Their perspective.</span></h2></div><p class="body-copy max-w-sm">Personal experiences from the people who put in the work.</p></div>{testimonials.length ? <div class="grid gap-6 md:grid-cols-3">{testimonials.map(t=><figure class="border-t-4 border-forest bg-white p-7"><blockquote class="text-xl leading-relaxed">“{t.quote}”</blockquote><figcaption class="mt-6 text-sm"><strong>{t.name}</strong><br />{t.role}</figcaption></figure>)}</div> : <div class="flex flex-col justify-between gap-6 border-y border-ink/20 py-8 sm:flex-row sm:items-center"><div><p class="text-xl font-bold">Player stories are on the way.</p><p class="mt-2 text-muted">Approved testimonials will be shared here. In the meantime, get to know the training through our session highlights.</p></div><a class="text-link shrink-0" href="/highlights/">See the sessions ↗</a></div>}</section>
