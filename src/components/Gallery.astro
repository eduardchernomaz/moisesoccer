---
import { photos } from '../site';
---
<section id="photos" class="shell section-pad"><div class="section-head"><div><p class="eyebrow mb-5">Photos / from the field</p><h2 class="section-title">This is where<br />the work happens.</h2></div><p class="max-w-sm text-muted">Moments and session stills from the Moïse Instagram feed. Select a photo to see the original post.</p></div><div class="grid grid-cols-2 gap-4 lg:grid-cols-4">{photos.map(photo=><figure><a href={photo.url} target="_blank" rel="noopener noreferrer" class="group block aspect-[3/4] overflow-hidden bg-forest" aria-label={photo.caption+' — original Instagram post'}><img src={photo.src} alt={photo.alt} width="480" height="640" loading="lazy" class="media-image" /></a><figcaption class="mt-3 text-sm font-semibold">{photo.caption}</figcaption></figure>)}</div></section>
