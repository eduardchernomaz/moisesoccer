---
import { highlights, business } from '../site';
---
<section id="videos" class="dark-surface bg-ink text-white section-pad"><div class="shell"><div class="section-head"><div><p class="eyebrow mb-5">Training session highlights</p><h2 class="section-title">See the work.<br /><span class="text-accent">Feel the energy.</span></h2></div><div><p class="max-w-sm text-base leading-relaxed text-white/65">Real sessions from the Moïse training field. Open a highlight to watch the full reel on Instagram.</p><a href={business.instagram} target="_blank" rel="noopener noreferrer" class="text-link mt-4 text-accent">More on Instagram ↗</a></div></div><div class="grid gap-5 sm:grid-cols-3">{highlights.map((video,i)=><a href={video.url} target="_blank" rel="noopener noreferrer" class="group block" aria-label={'Watch '+video.title+' on Instagram (opens in a new tab)'}><div class="relative aspect-[4/5] overflow-hidden bg-forest"><img src={video.image} alt={video.title} width="480" height="640" loading="lazy" class="media-image" /><div class="absolute inset-0 bg-gradient-to-t from-black/75 via-transparent to-transparent"></div><span class="absolute left-5 top-5 chip bg-ink/75 text-white">Session 0{i+1}</span><span class="absolute bottom-5 left-5 flex items-center gap-3 text-sm font-bold"><span class="flex size-11 items-center justify-center rounded-full bg-accent text-ink" aria-hidden="true">▶</span>Watch on Instagram ↗</span></div><h3 class="mt-5 text-xl font-bold">{video.title}</h3><p class="mt-1 text-sm text-white/60">{video.date}</p></a>)}</div><p class="mt-6 text-sm text-white/60">Instagram may ask you to sign in to watch. Videos are not loaded automatically.</p></div></section>
