---
import { plans } from '../site';
---
<div class="border border-ink/20 bg-white p-6 sm:p-9"><h2 class="display text-3xl">Let’s talk training.</h2><p class="mt-3 text-sm text-muted">Fields marked * are required. For a child, please use a parent or guardian’s contact details.</p>
<form name="contact" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="bot-field" class="mt-7 space-y-5">
<input type="hidden" name="form-name" value="contact" /><p hidden><label>Leave empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
<div><label for="name" class="font-semibold">Your name *</label><input class="field" id="name" name="name" autocomplete="name" maxlength="120" required /></div>
<div><label for="email" class="font-semibold">Email address *</label><input class="field" id="email" name="email" type="email" autocomplete="email" maxlength="254" required /></div>
<div><label for="interest" class="font-semibold">I’m interested in</label><select class="field" id="interest" name="interest"><option value="">Select an option (optional)</option>{plans.map(plan=><option value={plan.id}>{plan.title}</option>)}<option value="performance">Performance training</option><option value="payment">Payment question</option><option value="other">Something else</option></select></div>
<div><label for="message" class="font-semibold">Your message *</label><textarea class="field min-h-36" id="message" name="message" rows="5" minlength="10" maxlength="5000" required aria-describedby="message-hint"></textarea><p id="message-hint" class="mt-2 text-sm text-muted">Share your goals and general availability (at least 10 characters).</p></div>
<p class="text-sm leading-relaxed text-muted">Your details will be used to respond to your enquiry. Please don’t include medical or payment information.</p>
<button class="button button-dark w-full" type="submit">Send enquiry <span aria-hidden="true">↗</span></button>
<p class="text-sm text-muted">An enquiry does not book a session or take a payment.</p>
</form></div>
<script>
const interest = document.querySelector<HTMLSelectElement>('#interest');
const selected = new URLSearchParams(window.location.search).get('plan');
if (interest && selected && Array.from(interest.options).some(option => option.value === selected)) interest.value = selected;
</script>
