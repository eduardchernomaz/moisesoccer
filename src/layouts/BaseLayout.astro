---
import '../styles/global.css';
import { business, navigation } from '../site';
interface Props { title: string; description: string; noindex?: boolean; }
const { title, description, noindex = false } = Astro.props;
const fullTitle = title + ' | Moïse Soccer Training';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en"><head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title><meta name="description" content={description} /><link rel="canonical" href={canonical} />
<meta property="og:type" content="website" /><meta property="og:site_name" content={business.name} /><meta property="og:title" content={fullTitle} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
<meta name="twitter:card" content="summary" /><meta name="twitter:title" content={fullTitle} /><meta name="twitter:description" content={description} /><meta name="theme-color" content="#101713" />
{(noindex || Astro.site?.hostname === 'example.com') && <meta name="robots" content="noindex, follow" />}
<link rel="icon" type="image/png" href="/images/moise-logo.png?v=2" />
</head><body>
<a href="#main" class="fixed left-4 top-4 z-50 -translate-y-32 bg-accent px-5 py-3 text-ink focus:translate-y-0">Skip to content</a>
<header class="border-b border-ink/15 bg-paper"><div class="shell flex flex-wrap items-center justify-between gap-4 py-4">
<a href="/" class="flex items-center gap-3" aria-label={business.name + ' home'}><img src="/images/moise-logo.png?v=2" width="64" height="64" alt="" class="size-16 object-contain" /><span><span class="block font-display text-3xl font-extrabold leading-none tracking-tight">MOÏSE</span><span class="mt-1 block text-xs font-semibold">Soccer & Performance</span></span></a>
<nav aria-label="Main navigation" class="hidden items-center gap-6 lg:flex">{navigation.map(({href,label})=><a href={href} aria-current={Astro.url.pathname===href?'page':undefined} class:list={['py-3 text-sm font-semibold hover:underline underline-offset-8',{'underline':Astro.url.pathname===href}]}>{label}</a>)}</nav>
<a href="/booking/" class="button hidden sm:inline-flex">Book training <span aria-hidden="true">↗</span></a>
<details class="group w-full lg:hidden"><summary class="flex min-h-11 list-none items-center justify-between border border-ink/20 px-4 text-sm font-semibold uppercase tracking-wider [&::-webkit-details-marker]:hidden">Explore <span aria-hidden="true" class="group-open:rotate-45">+</span></summary><nav aria-label="Mobile navigation" class="mt-2 grid grid-cols-2 border border-ink/15 p-2">{[...navigation,{href:'/booking/',label:'Booking'},{href:'/payment/',label:'Payment'}].map(({href,label})=><a class="px-3 py-3 text-sm font-semibold hover:bg-accent" href={href} aria-current={Astro.url.pathname===href?'page':undefined}>{label}</a>)}</nav></details>
</div></header>
<main id="main" tabindex="-1"><slot /></main>
<footer class="dark-surface bg-ink text-white"><div class="shell grid gap-10 py-14 md:grid-cols-[1.3fr_1fr_1fr]"><div><a href="/" class="inline-block" aria-label={business.name + ' home'}><img src="/images/moise-logo.png?v=2" width="112" height="112" alt="Moïse Soccer & Performance Training crest" loading="lazy" class="size-28 object-contain" /></a><p class="mt-3 text-sm text-white/65">Soccer & Performance Training<br />New York City</p><a class="text-link mt-5 text-accent" href={business.instagram} target="_blank" rel="noopener noreferrer">Follow the training ↗</a></div><nav aria-label="Footer navigation" class="grid grid-cols-2 content-start gap-1">{[...navigation,{href:'/booking/',label:'Booking'},{href:'/payment/',label:'Payment'},{href:'/#testimonials',label:'Testimonials'}].map(({href,label})=><a class="py-2 text-sm text-white/80 hover:text-accent" href={href}>{label}</a>)}</nav><div><p class="eyebrow mb-4">Your next step</p><p class="text-xl font-semibold">Bring your goals.<br />Let’s get to work.</p><a class="button mt-6" href="/contact/">Contact us ↗</a></div></div><div class="shell flex flex-wrap justify-between gap-4 border-t border-white/15 py-6 text-xs text-white/60"><p>© {new Date().getFullYear()} {business.name}</p><p>1-on-1 · Small group · Performance</p></div></footer>
</body></html>
